# One class per structure; the element type is `.dtype` (bool = bit, int8..uint64,
# float16/32/64, complex_float16/32/64).
class DenseMatrix(MatrixBase):
    def __init__(self, rows: int, cols: Optional[int] = None, dtype: str = "float64") -> None: ...
    def set_identity(self) -> None: ...
    def __and__(self, other: MatrixBase) -> MatrixBase: ...
    def __or__(self, other: MatrixBase) -> MatrixBase: ...
    def __xor__(self, other: MatrixBase) -> MatrixBase: ...
    @staticmethod
    def random(rows: int, cols: Optional[int] = None, p: float = 0.5, seed: Optional[int] = None) -> DenseMatrix: ...

class TriangularMatrix(MatrixBase):
    def __init__(self, n: int, dtype: str = "float64", has_diagonal: bool = False) -> None: ...
    @property
    def has_diagonal(self) -> bool: ...
    @staticmethod
    def random(n: int, p: float = 0.5, seed: Optional[int] = None) -> TriangularMatrix: ...

class DiagonalMatrix(MatrixBase):
    def __init__(self, n: int, dtype: str = "float64") -> None: ...
    def get_diagonal(self, i: int) -> Any: ...
    def set_diagonal(self, i: int, value: Any) -> None: ...

class IdentityMatrix(MatrixBase):
    def __init__(self, rows: int, cols: Optional[int] = None, dtype: str = "float64") -> None: ...

class SymmetricMatrix(MatrixBase):
    def __init__(self, n: int, dtype: str = "float64") -> None: ...
    @staticmethod
    def from_triangular(source: TriangularMatrix) -> SymmetricMatrix: ...

class AntiSymmetricMatrix(MatrixBase):
    def __init__(self, n: int, dtype: str = "float64") -> None: ...
    @staticmethod
    def from_triangular(source: TriangularMatrix) -> AntiSymmetricMatrix: ...

